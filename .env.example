DATABASE_URL=postgres://gantrix:gantrix@127.0.0.1:15432/gantrix
REDIS_URL=redis://127.0.0.1:16379

GANTRIX_HOST=127.0.0.1
GANTRIX_PORT=4700
# Required. Generate one with: openssl rand -hex 32
GANTRIX_TOKEN=

# Any Ollama or OpenAI-compatible endpoint; agents can override per agent
OLLAMA_BASE_URL=http://127.0.0.1:11434
GANTRIX_DEFAULT_MODEL=qwen3:8b
# Optional: a saved connection (gantrix connections add …) for the planner and judge.
# GANTRIX_DEFAULT_CONNECTION=
# Keys that connections read with env:NAME, for example:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Model calls in flight; bounded by your GPU memory
GANTRIX_LLM_CONCURRENCY=2

# One folder per task; file tools can't leave it
GANTRIX_WORKSPACES_DIR=~/.gantrix/workspaces
GANTRIX_SKILLS_DIR=~/.gantrix/skills

# Default per-task budgets (a task can override them)
GANTRIX_MAX_STEP_ATTEMPTS=3
GANTRIX_MAX_REPLANS=5
GANTRIX_MAX_TOKENS=200000
GANTRIX_MAX_MINUTES=60
# true (default): tool calls, including shell and email, run without asking unless a task
# turns on "ask first". false: every new task asks before shell, web, MCP and email tools.
GANTRIX_APPROVE_ALL=true
