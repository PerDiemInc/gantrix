{
  "name": "@gantrix/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api": "node --env-file-if-exists=../../.env src/main-api.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env src/db/migrate.ts",
    "dev:api": "node --env-file-if-exists=../../.env --watch src/main-api.ts",
    "dev:worker": "node --env-file-if-exists=../../.env --watch src/main-worker.ts",
    "typecheck": "tsc -p .",
    "worker": "node --env-file-if-exists=../../.env src/main-worker.ts"
  },
  "dependencies": {
    "@gantrix/shared": "*",
    "@langchain/core": "^1.3.4",
    "@langchain/langgraph": "^1.7.0",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.2",
    "@langchain/mcp-adapters": "^2.0.2",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.8.0",
    "bullmq": "^6.7.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
